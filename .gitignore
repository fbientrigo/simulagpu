# Dependencies
node_modules/

# Web build output
apps/docs/.vitepress/dist/
apps/docs/.vitepress/cache/
*.tsbuildinfo

# Generated content.
# The Anki TSV and web JSON are produced by `pnpm anki:build` from
# anki/cards/*.yaml. They are build artifacts of the docs site, not sources:
# committing them would mean reviewing generated diffs on every card change.
apps/docs/public/descargas/*.tsv
apps/docs/public/data/simulagpu-anki.json

# Native build directories
native/build*/
native/exercises/*/starter/build*/
native/exercises/*/solution/build*/
CMakeUserPresets.json

